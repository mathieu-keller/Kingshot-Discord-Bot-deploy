{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":semanticCommits",
    "group:monorepos",
    ":prImmediately",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone"
  ],
  "assigneesFromCodeOwners": true,
  "dependencyDashboard": true,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "platformAutomerge": true
}
